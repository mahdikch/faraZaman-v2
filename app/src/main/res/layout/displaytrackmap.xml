<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <org.osmdroid.views.MapView
        android:id="@+id/displaytrackmap_osmView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Ir.co.tfs.farazaman.layout.GpsStatusRecordDisplay
        android:id="@+id/gpsStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingVertical="16dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/fab_back_to_track_manager"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/map_control_btn_bg"
        android:contentDescription="@string/map_back"
        android:elevation="6dp"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_intro_arrow_forward"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#212121" />

    <ImageButton
        android:id="@+id/displaytrackmap_imgZoomCenter"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/map_control_btn_bg"
        android:contentDescription="@string/map_my_location"
        android:elevation="6dp"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_my_location"
        app:layout_constraintBottom_toTopOf="@id/road_info_container"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="@color/supervisor_header_green" />

    <LinearLayout
        android:id="@+id/mapControlsColumn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:gravity="end"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/road_info_container"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/layerItemsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/btnLayersToggle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/map_layers_toggle_bg"
            android:contentDescription="@string/map_layers"
            android:elevation="6dp"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_map_plus" />

        <ImageButton
            android:id="@+id/btnZoomIn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/map_control_btn_bg"
            android:contentDescription="@string/map_zoom_in"
            android:elevation="6dp"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_map_zoom_in" />

        <ImageButton
            android:id="@+id/btnZoomOut"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/map_control_btn_bg"
            android:contentDescription="@string/map_zoom_out"
            android:elevation="6dp"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_map_zoom_out" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/road_info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/map_bottom_sheet_bg"
        android:elevation="12dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="@drawable/bottom_sheet_handle" />

        <TextView
            android:id="@+id/road_name_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/iran_sans"
            android:gravity="center"
            android:text="@string/map_street_name_label"
            android:textColor="#05493E"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/road_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/iran_sans"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_secondary_dark"
            android:textSize="14sp"
            tools:text="خیابان دیباجی جنوبی، کوچه مژگان" />

        <TextView
            android:id="@+id/road_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/speed_limit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

    <Button
        android:id="@+id/submit_violation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="ثبت تخلف"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.leinardi.android.speeddial.SpeedDialView
        android:id="@+id/speedDial"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
