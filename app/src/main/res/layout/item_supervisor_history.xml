<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#D6EBE8"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="@color/intro_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/iran_sans"
                android:text="@string/violation_group_label"
                android:textAlignment="viewStart"
                android:textColor="@color/text_secondary_dark"
                android:textDirection="rtl"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/historyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/iran_sans"
                android:textAlignment="viewStart"
                android:textColor="@color/login_label"
                android:textDirection="rtl"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="عدم نظافت دستی معابر" />

            <TextView
                android:id="@+id/historySubtitleLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/iran_sans"
                android:text="@string/violation_defect_title_label"
                android:textAlignment="viewStart"
                android:textColor="@color/text_secondary_dark"
                android:textDirection="rtl"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/historySubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/iran_sans"
                android:textAlignment="viewStart"
                android:textColor="@color/login_label"
                android:textDirection="rtl"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="عدم جمع‌آوری پسماند"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/historyDateTimes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/iran_sans"
                android:lineSpacingExtra="4dp"
                android:textAlignment="viewStart"
                android:textColor="@color/text_secondary_dark"
                android:textDirection="rtl"
                android:textSize="12sp"
                tools:text="۱۴۰۴/۰۹/۱۹ - ۰۸:۳۰\n۱۴۰۴/۰۹/۱۹ - ۱۱:۱۵" />

            <LinearLayout
                android:id="@+id/statusBadges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
