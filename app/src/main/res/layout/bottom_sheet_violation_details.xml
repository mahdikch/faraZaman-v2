<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/supervisor_info_row_divider" />

    <TextView
        android:id="@+id/detailsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/iran_sans"
        android:textAlignment="viewStart"
        android:textDirection="rtl"
        android:textColor="@color/intro_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="جزئیات تخلف نظافت دستی معابر" />

    <TextView
        android:id="@+id/detailsSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/iran_sans"
        android:textAlignment="viewStart"
        android:textDirection="rtl"
        android:textColor="@color/text_secondary_dark"
        android:textSize="13sp"
        tools:text="با عرض بین ۱۵ تا ۲۵ متر" />

    <LinearLayout
        android:id="@+id/detailsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/violation_dashed_border_bg"
        android:orientation="vertical"
        android:padding="16dp" />
</LinearLayout>
