<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layoutDirection="rtl">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        android:padding="10dp"
        android:scaleX="-1"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/intro_primary" />

    <TextView
        android:id="@+id/pageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/iran_sans"
        android:text="@string/violation_form_title"
        android:textColor="@color/intro_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <TextView
        android:id="@+id/gps_warning"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/warning_background"
        android:fontFamily="@font/iran_sans"
        android:padding="12dp"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/formScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/save"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/gps_warning">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="rtl"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/summaryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/violation_summary_card_bg"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layoutDirection="rtl"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/intro_skip_button_bg">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_nav_schedule"
                            app:tint="@color/intro_primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/summaryDefectTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/iran_sans"
                            android:textAlignment="viewStart"
                            android:textDirection="rtl"
                            android:textColor="@color/intro_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="عدم نظافت دستی معابر با عرض ۱۵ متر" />

                        <TextView
                            android:id="@+id/summaryVisitDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/iran_sans"
                            android:textAlignment="viewStart"
                            android:textDirection="rtl"
                            android:textColor="@color/text_secondary_dark"
                            android:textSize="12sp"
                            tools:text="تاریخ ثبت عملکرد : ۱۴۰۴/۰۹/۰۱" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/btnViewDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/violation_summary_footer_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/iran_sans"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="@string/violation_view_more_details"
                    android:textColor="@color/intro_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/dailyPlanDefectSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:visibility="gone">

                <include
                    android:id="@+id/defectSelectorBlock"
                    layout="@layout/include_violation_form_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/iran_sans"
                android:textAlignment="viewStart"
                android:textDirection="rtl"
                android:text="@string/violation_count_label"
                android:textColor="@color/login_label"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/count"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/violation_input_bg"
                android:fontFamily="@font/iran_sans"
                android:gravity="center_vertical"
                android:textAlignment="viewStart"
                android:textDirection="rtl"
                android:inputType="number"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/iran_sans"
                android:textAlignment="viewStart"
                android:textDirection="rtl"
                android:text="@string/violation_description_label"
                android:textColor="@color/login_label"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/violation_input_bg"
                android:fontFamily="@font/iran_sans"
                android:gravity="top"
                android:textAlignment="viewStart"
                android:textDirection="rtl"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:padding="14dp"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/iran_sans"
                android:textAlignment="viewStart"
                android:textDirection="rtl"
                android:text="@string/violation_address_label"
                android:textColor="@color/login_label"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/adress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/violation_input_bg"
                android:fontFamily="@font/iran_sans"
                android:textAlignment="viewStart"
                android:textDirection="rtl"
                android:inputType="text"
                android:minLines="2"
                android:padding="14dp"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/iran_sans"
                android:textAlignment="viewStart"
                android:textDirection="rtl"
                android:text="@string/violation_images_label"
                android:textColor="@color/login_label"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/violation_input_bg"
                android:gravity="center_vertical"
                android:layoutDirection="rtl"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/image_picker"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/iran_sans"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/violation_pick_images"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    app:backgroundTint="@null"
                    android:background="@drawable/violation_pick_image_btn"
                    app:cornerRadius="0dp"
                    app:icon="@drawable/ic_nav_schedule"
                    app:iconGravity="textStart"
                    app:iconPadding="4dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/white" />

                <TextView
                    android:id="@+id/txtImageFileName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/iran_sans"
                    android:gravity="center_vertical"
                    android:paddingEnd="12dp"
                    android:textAlignment="viewStart"
                    android:textDirection="rtl"
                    android:textColor="@color/text_secondary_dark"
                    android:textSize="12sp"
                    tools:text="IMG-301044" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/iran_sans"
                android:textAlignment="viewStart"
                android:textDirection="rtl"
                android:text="@string/violation_max_file_size"
                android:textColor="@color/text_secondary_dark"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/imagesPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/violation_dashed_border_bg"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/txtImagesCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/iran_sans"
                    android:textAlignment="viewStart"
                    android:textDirection="rtl"
                    android:textColor="@color/login_label"
                    android:textSize="13sp"
                    tools:text="۵ تصویر بارگذاری شده" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/images_preview_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShowAllImages"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/iran_sans"
                    android:text="@string/violation_show_all_images"
                    android:textColor="@color/intro_primary"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_nav_schedule"
                    app:iconGravity="textStart"
                    app:iconTint="@color/intro_primary" />
            </LinearLayout>

            <include layout="@layout/include_violation_form_hidden_fields" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/save"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/iran_sans"
        android:text="@string/violation_save"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:backgroundTint="@color/intro_primary"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
