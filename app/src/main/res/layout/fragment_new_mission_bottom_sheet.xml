<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_top_background"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bottom_sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/iran_sans"
        android:gravity="center"
        android:text="@string/mission_receive_title"
        android:textColor="@color/brand_green_dark"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/iran_sans"
        android:text="@string/mission_visit_date_label"
        android:textAlignment="viewStart"
        android:textColor="@color/login_label"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/persian_date_text"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/login_input_background"
        android:fontFamily="@font/iran_sans"
        android:gravity="center_vertical|end"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textAlignment="viewEnd"
        android:textColor="@color/login_label"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/iran_sans"
        android:text="@string/mission_organ_label"
        android:textAlignment="viewStart"
        android:textColor="@color/login_label"
        android:textSize="14sp" />

    <FrameLayout
        android:id="@+id/organSelector"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/login_input_background"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <ProgressBar
            android:id="@+id/organProgress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/organSelectedText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/iran_sans"
            android:gravity="center_vertical|end"
            android:hint="@string/mission_select_organ_hint"
            android:paddingStart="44dp"
            android:paddingEnd="16dp"
            android:textAlignment="viewEnd"
            android:textColor="@color/login_label"
            android:textColorHint="@color/text_secondary_dark"
            android:textSize="15sp" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="12dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_down" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/iran_sans"
        android:text="@string/mission_contract_label"
        android:textAlignment="viewStart"
        android:textColor="@color/login_label"
        android:textSize="14sp" />

    <FrameLayout
        android:id="@+id/contractSelector"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:alpha="0.6"
        android:background="@drawable/login_input_background"
        android:clickable="false"
        android:focusable="false"
        android:foreground="?attr/selectableItemBackground">

        <ProgressBar
            android:id="@+id/contractProgress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/contractSelectedText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/iran_sans"
            android:gravity="center_vertical|end"
            android:hint="@string/mission_select_contract_hint"
            android:paddingStart="44dp"
            android:paddingEnd="16dp"
            android:textAlignment="viewEnd"
            android:textColor="@color/login_label"
            android:textColorHint="@color/text_secondary_dark"
            android:textSize="15sp" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="12dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_down" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/submit_mission_button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:enabled="false"
        android:fontFamily="@font/iran_sans"
        android:text="@string/mission_receive_submit"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:backgroundTint="@color/intro_primary"
        app:cornerRadius="12dp" />

</LinearLayout>
